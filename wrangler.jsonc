// Cloudflare 워커 "wine" = 와인 저널 (Next.js 16 → vinext로 빌드)
// - 빌드: npm run build:vinext → dist/ (화면 파일은 dist/client, 서버는 vinext fetch-handler)
// - 비밀값 ANTHROPIC_API_KEY는 대시보드에만 입력 (Settings → Variables and Secrets)
// - NEXT_PUBLIC_SUPABASE_* 는 빌드 때 코드에 박히므로 Workers Builds의 "빌드 변수"에도 넣어야 함
// 배포: main에 push하면 Workers Builds가 자동 배포
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wine",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  // 한국 요청이 홍콩 데이터센터로 가면 Anthropic이 403 "Request not allowed"로 막음 → 미국 동부에서 실행
  "placement": { "region": "aws:us-east-1" },
  "observability": { "enabled": true }
}
